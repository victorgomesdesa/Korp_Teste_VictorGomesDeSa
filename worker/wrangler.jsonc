{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "korp-voice-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    // Origem do frontend liberada por CORS; sobrescreva no deploy se publicar o Angular.
    "ALLOWED_ORIGIN": "http://localhost:4200"
  }
}
